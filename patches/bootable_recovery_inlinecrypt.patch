 			// fileencryption=ice:aes-256-heh
 			{
+#ifdef TW_FBE_FORCE_INLINECRYPT
+				// A ROM for a 4.4 kernel uses fileencryption=ice without
+				// inlinecrypt, which its ext4 rejects. From 4.19, ice contents
+				// only decrypt through blk-crypto when /data is mounted with
+				// inlinecrypt; without it, reads return ciphertext.
+				struct utsname uts;
+				unsigned kmajor = 0, kminor = 0;
+				if (uname(&uts) == 0)
+					sscanf(uts.release, "%u.%u", &kmajor, &kminor);
+				if (Mount_Point == "/data" &&
+				    std::string(str).compare(0, 3, "ice") == 0 &&
+				    (kmajor > 4 || (kmajor == 4 && kminor >= 19)) &&
+				    ("," + Mount_Options + ",").find(",inlinecrypt,") == std::string::npos) {
+					if (!Mount_Options.empty())
+						Mount_Options += ",";
+					Mount_Options += "inlinecrypt";
+					LOGINFO("Added inlinecrypt to the /data mount options\n");
+				}
+#endif
 				std::string FBE = str;
 				size_t colon_loc = FBE.find(":");
 				if (colon_loc == std::string::npos) {
