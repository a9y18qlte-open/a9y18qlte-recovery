 			{
+#ifdef TW_FBE_FORCE_INLINECRYPT
+				// The ROM's fstab may come from a kernel whose ext4 has no
+				// inlinecrypt option, but this kernel only decrypts file
+				// contents through the inline crypto engine when /data is
+				// mounted with it. Without it, reads return ciphertext.
+				if (Mount_Point == "/data" &&
+				    ("," + Mount_Options + ",").find(",inlinecrypt,") == std::string::npos) {
+					if (!Mount_Options.empty())
+						Mount_Options += ",";
+					Mount_Options += "inlinecrypt";
+					LOGINFO("Added inlinecrypt to the /data mount options\n");
+				}
+#endif
