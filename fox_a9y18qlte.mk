# screen settings
OF_SCREEN_H := 2220

# flashlight
OF_FLASHLIGHT_ENABLE := 0

# system-as-root detection
OF_USE_TWRP_SAR_DETECT := 1

# disable dm verity
OF_FORCE_DISABLE_DM_VERITY := 1

# FRP
OF_ENABLE_FRP_ADDON := 1

OF_NO_TREBLE_COMPATIBILITY_CHECK := 1

# encryption stiff
OF_KEEP_FORCED_ENCRYPTION := 1
OF_DONT_PATCH_ENCRYPTED_DEVICE := 1

# use legacy code for wrong clock issues
OF_USE_LEGACY_TIME_FIXUP := 1

# keymaster
OF_DEFAULT_KEYMASTER_VERSION := 3.0

# battery
OF_USE_LEGACY_BATTERY_SERVICES := 1

# maintainer
OF_MAINTAINER := James Nguyen
